{
  "archetype_id": "proposal_commercial",
  "name": "Propuesta Comercial",
  "description": "Propuesta de venta para un cliente nuevo o existente. Co-branding equitativo en portada y contexto, identidad Minsait dominante en propuesta y cierre.",
  "typical_length_slides": [25, 35, 45],
  "co_branding": true,
  "skeleton": [
    {"order": 1, "section": "cover", "layout_index": 6, "title_template": "{{deck_title}}", "subtitle_template": "Propuesta de enfoque · {{month_year}}", "required": true, "client_logo_slot": true},
    {"order": 2, "section": "objectives", "layout_index": 17, "title": "Objetivos del documento", "content_template": "Presentar nuestra propuesta de apoyo a {{client_name}} en {{topic}}.", "required": true},
    {"order": 3, "section": "index", "layout_index": 12, "title": "Índice", "sections_template": ["01 Contexto y entendimiento del reto", "02 Propuesta y visión metodológica", "03 Plan de trabajo y equipo", "04 Inversión"], "required": true},
    {"order": 4, "section": "section_divider_1", "layout_index": 13, "label": "01", "title": "Contexto y entendimiento del reto", "required": true},
    {"order": 5, "section": "context_situation", "layout_index": 18, "title_template": "{{client_name}} se encuentra en un momento de {{trigger_event}}", "body": "situación actual del cliente en 3-5 frases", "client_imagery_allowed": true, "required": true},
    {"order": 6, "section": "context_pains", "layout_index": 17, "title": "Hemos identificado tres dolores principales que afrontar", "body": "lista de 3 pains con sustento", "required": true},
    {"order": 7, "section": "context_opportunity", "layout_index": 28, "title_template": "Resolver esto puede generar {{key_outcome}}", "body": "oportunidad cuantificada", "required": false, "key_idea": true},
    {"order": 8, "section": "section_divider_2", "layout_index": 13, "label": "02", "title": "Propuesta y visión metodológica", "required": true},
    {"order": 9, "section": "value_proposition_one_liner", "layout_index": 28, "title_template": "Proponemos {{one_liner_solution}}", "required": true, "key_idea": true},
    {"order": 10, "section": "value_proposition_pillars", "layout_index": 17, "title": "Nuestra propuesta se estructura en 3 pilares", "body": "los 3 pilares de la propuesta", "required": true},
    {"order": 11, "section": "approach_methodology", "layout_index": 17, "title": "Metodología de trabajo", "body": "enfoque metodológico Minsait aplicado al caso", "required": true},
    {"order": 12, "section": "phases", "layout_index": 17, "title_template": "El proyecto se ejecuta en {{n_phases}} fases en {{total_weeks}} semanas", "body": "tabla o diagrama con las fases, sus entregables y duración", "required": true},
    {"order": 13, "section": "deliverables_summary", "layout_index": 17, "title": "Entregables por fase", "body": "lista detallada de entregables", "required": false},
    {"order": 14, "section": "section_divider_3", "layout_index": 13, "label": "03", "title": "Plan de trabajo y equipo", "required": true},
    {"order": 15, "section": "timeline", "layout_index": 18, "title": "Plan de trabajo por semanas", "body": "Gantt simplificado con hitos", "required": true},
    {"order": 16, "section": "team", "layout_index": 17, "title": "Equipo del proyecto", "body": "Partner, Manager, Consultores, especialistas", "required": true},
    {"order": 17, "section": "client_dependencies", "layout_index": 17, "title": "Dependencias e inputs requeridos del cliente", "body": "lista de inputs/dependencias", "required": false},
    {"order": 18, "section": "risks_mitigation", "layout_index": 17, "title": "Riesgos principales y mitigación", "body": "tabla riesgo / mitigación", "required": false},
    {"order": 19, "section": "why_minsait", "layout_index": 17, "title_template": "Por qué Minsait en {{topic_short}}", "body": "3 razones diferenciales", "required": false},
    {"order": 20, "section": "case_studies", "layout_index": 26, "title": "Casos de éxito relevantes", "body": "1-3 casos previos con outcomes", "required": false},
    {"order": 21, "section": "section_divider_4", "layout_index": 13, "label": "04", "title": "Inversión", "required": true},
    {"order": 22, "section": "investment", "layout_index": 17, "title": "Propuesta económica", "body_template": "Honorarios totales: {{total_amount}} {{currency}}. Modalidad: {{billing_modality}}.", "required": true},
    {"order": 23, "section": "commercial_conditions", "layout_index": 17, "title": "Condiciones comerciales", "body": "validez de oferta, gastos no incluidos, escalamiento de tarifas", "required": false},
    {"order": 24, "section": "closing", "layout_index": 35, "required": true}
  ],
  "interview_blocks_required": [0, 1, 2, 3, 4, 5],
  "interview_blocks_optional": [6]
}
