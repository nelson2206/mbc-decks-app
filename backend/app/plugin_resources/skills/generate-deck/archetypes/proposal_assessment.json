{
  "archetype_id": "proposal_assessment",
  "name": "Assessment de Madurez",
  "description": "Diagnóstico de madurez del cliente en un dominio (datos, IA, procesos, etc.) con framework, brechas y roadmap. Co-branding equitativo en portada y contexto.",
  "typical_length_slides": [40, 70, 90],
  "co_branding": true,
  "skeleton": [
    {"order": 1, "section": "cover", "layout_index": 6, "title_template": "Assessment de Madurez · {{domain}}", "subtitle_template": "{{client_name}} · {{month_year}}", "required": true, "client_logo_slot": true},
    {"order": 2, "section": "objectives", "layout_index": 17, "title": "Objetivos del assessment", "body_template": "Entender el estado actual de {{domain}}, identificar brechas y proponer un roadmap de evolución.", "required": true},
    {"order": 3, "section": "index", "layout_index": 12, "title": "Índice", "sections_template": ["01 Entendimiento de la situación", "02 Framework de madurez", "03 Hallazgos y brechas", "04 Roadmap propuesto"], "required": true},
    {"order": 4, "section": "section_divider_1", "layout_index": 13, "label": "01", "title": "Entendimiento de la situación", "required": true},
    {"order": 5, "section": "industry_context", "layout_index": 18, "title": "Desafíos críticos de la industria", "body": "contexto sectorial relevante", "client_imagery_allowed": true, "required": true},
    {"order": 6, "section": "client_context", "layout_index": 17, "title_template": "{{client_name}}: situación actual", "body": "estado actual del cliente en el dominio", "required": true},
    {"order": 7, "section": "ambition", "layout_index": 28, "title": "Ambición del cliente", "key_idea": true, "required": false},
    {"order": 8, "section": "section_divider_2", "layout_index": 13, "label": "02", "title": "Framework de madurez", "required": true},
    {"order": 9, "section": "framework_overview", "layout_index": 17, "title": "Framework de madurez Minsait", "body": "diagrama del framework con sus dimensiones", "required": true},
    {"order": 10, "section": "framework_dimensions", "layout_index": 17, "title": "Dimensiones evaluadas", "body": "lista detallada de dimensiones", "required": true},
    {"order": 11, "section": "maturity_levels", "layout_index": 17, "title": "Niveles de madurez", "body": "definición de niveles 1-5", "required": true},
    {"order": 12, "section": "methodology", "layout_index": 17, "title": "Metodología del assessment", "body": "fases del assessment", "required": true},
    {"order": 13, "section": "section_divider_3", "layout_index": 13, "label": "03", "title": "Hallazgos y brechas", "required": true},
    {"order": 14, "section": "executive_summary", "layout_index": 28, "title": "Resumen ejecutivo de hallazgos", "key_idea": true, "required": true},
    {"order": 15, "section": "current_state_radar", "layout_index": 17, "title": "Estado actual por dimensión", "body": "radar/tabla con los niveles de madurez actuales", "required": true},
    {"order": 16, "section": "gaps_dimension_1", "layout_index": 17, "title_template": "Brechas en {{dimension_1}}", "required": true},
    {"order": 17, "section": "gaps_dimension_2", "layout_index": 17, "title_template": "Brechas en {{dimension_2}}", "required": true},
    {"order": 18, "section": "gaps_dimension_3", "layout_index": 17, "title_template": "Brechas en {{dimension_3}}", "required": false},
    {"order": 19, "section": "gaps_dimension_4", "layout_index": 17, "title_template": "Brechas en {{dimension_4}}", "required": false},
    {"order": 20, "section": "section_divider_4", "layout_index": 13, "label": "04", "title": "Roadmap propuesto", "required": true},
    {"order": 21, "section": "future_state", "layout_index": 17, "title": "Estado objetivo", "body": "estado futuro deseado por dimensión", "required": true},
    {"order": 22, "section": "roadmap_overview", "layout_index": 17, "title_template": "Roadmap de evolución a {{horizon}}", "body": "diagrama del roadmap (corto/medio/largo plazo)", "required": true},
    {"order": 23, "section": "initiatives_short_term", "layout_index": 17, "title": "Iniciativas de corto plazo (0-6 meses)", "required": true},
    {"order": 24, "section": "initiatives_medium_term", "layout_index": 17, "title": "Iniciativas de medio plazo (6-18 meses)", "required": true},
    {"order": 25, "section": "initiatives_long_term", "layout_index": 17, "title": "Iniciativas de largo plazo (18+ meses)", "required": false},
    {"order": 26, "section": "expected_outcomes", "layout_index": 28, "title": "Beneficios esperados", "key_idea": true, "required": true},
    {"order": 27, "section": "investment_estimate", "layout_index": 17, "title": "Estimación de inversión total del roadmap", "required": false},
    {"order": 28, "section": "next_steps", "layout_index": 17, "title": "Próximos pasos sugeridos", "required": true},
    {"order": 29, "section": "closing", "layout_index": 35, "required": true}
  ],
  "interview_blocks_required": [0, 1, 2, 3, 4],
