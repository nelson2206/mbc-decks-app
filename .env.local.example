# Variables locales para desarrollo (NO subir a git)
# Renombrar a .env.local y completar con tus credenciales reales

# ====== ANTHROPIC ======
# Sacar de https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ====== DATABASE (Neon.tech) ======
# Connection string completo de Neon. Cambiar postgresql:// por postgresql+psycopg2://
DATABASE_URL=postgresql+psycopg2://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ====== STORAGE (Cloudflare R2) ======
STORAGE_BACKEND=s3
S3_BUCKET=mbc-decks-storage
S3_REGION=auto
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=...
S3_SECRET_KEY=...

# ====== AUTH ======
# Generar con: openssl rand -hex 32
JWT_SECRET=change-this-to-64-random-hex-chars

# ====== FRONTEND ======
# URL del backend en producción
NEXT_PUBLIC_API_URL=https://mbc-decks-backend.onrender.com

# ====== CORS ======
# Lista JSON de orígenes permitidos. En desarrollo dejar localhost:3000.
CORS_ALLOWED_ORIGINS=["http://localhost:3000","https://mbc-decks.vercel.app"]
